<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- APK de actualización: se descarga en cache/updates y se comparte con
         el instalador del sistema vía FileProvider. Sin esta entrada,
         getUriForFile() falla con IllegalArgumentException y la instalación
         nunca arranca. -->
    <cache-path
        name="updates"
        path="updates/" />
    <external-path
        name="external_files"
        path="." />
</paths>
